# Cavos app id — activates the gasless relayer + branding. Register at cavos.xyz.
NEXT_PUBLIC_CAVOS_APP_ID=

# Solana devnet RPC (Alchemy/Helius). Public devnet fails from the browser.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Starknet paymaster API key — REQUIRED to connect on Starknet. Without it,
# selecting the Starknet chain will fail to connect. Get it from the Cavos
# dashboard (paymaster section).
NEXT_PUBLIC_STARKNET_PAYMASTER_API_KEY=

# Stellar treasury for the "Receive a USDC payment" demo. Server-only — never NEXT_PUBLIC_.
# A testnet G… funded with XLM (friendbot) that already holds the USDC below.
STELLAR_TREASURY_SECRET=

# The exact USDC the demo pays and Reserve charges in (CODE:ISSUER). Must be listed by
# GET https://reserve.cavos.xyz/testnet/v1/tokens. Default is Cavos Testnet USDC (cavos.xyz).
NEXT_PUBLIC_STELLAR_USDC=USDC:GCKUFD5KAAM6DRSLODK55OVECMB5IJ5NSFQYFTBZRPOTJASUKTBZXGS2

# USDC per claimable. Must exceed the activate maxSend ceiling (5).
STELLAR_CLAIMABLE_AMOUNT=25
